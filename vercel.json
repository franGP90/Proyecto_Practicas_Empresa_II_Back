{
    "version": 2,
    "builds": [
        {
        "src": "*.ts",
        "use":"@vercel/node"            
        }
    ],
    "routes": [
        {
            "src":"/(.*)",
            "dest":"/",
            "methods": ["GET","POST","PUT","DELETE","PATCH","OPTIONS"],
            "hedaers": {
                "Access-Controll-Allow-Origin":"*",
                "Access-Controll-Allow-Credentials":"true",
                "Access-Controll-Allow-Headers": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-API-Version"
            }
        }
    ]
}